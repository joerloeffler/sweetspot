{
  "schema_version": 1,
  "name": "example_protein_ions",
  "backend": {"name": "esmfold2", "model": "quality", "dtype": "float32", "chunk_size": 64},
  "proteins": [
    {
      "id": "metalloprotein",
      "fasta": "inputs/monomer.fasta",
      "chains": ["A"],
      "glycosylation": {"enabled": false}
    }
  ],
  "ions": {
    "mode": "explicit",
    "species": [
      {"ccd": "ZN", "count": 1, "role": "catalytic"},
      {"ccd": "CA", "count": 2, "role": "structural"}
    ],
    "environment": {"ionic_strength_mM": 150, "notes": "Provenance only; no bulk counterions are generated."}
  },
  "msa": {"source": "none"},
  "prediction": {"num_loops": 3, "sampling_steps": 50, "diffusion_samples": 1, "seed": 0},
  "output": {"directory": "results", "format": "mmcif"}
}
